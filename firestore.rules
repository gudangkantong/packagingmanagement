rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null && request.auth.token != null && request.auth.token.email != null;
    }

    function isMasterAdmin() {
      return isAuthenticated() &&
        request.auth.token.email == get(/databases/$(database)/documents/config/master_admin).data.email;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/allowed_users/$(request.auth.token.email)).data.role;
    }

    function isUserAllowed() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/allowed_users/$(request.auth.token.email)) &&
             get(/databases/$(database)/documents/allowed_users/$(request.auth.token.email)).data.allowed == true;
    }

    function isSuperAdmin() {
      return isMasterAdmin() || (isUserAllowed() && getUserRole() == "super_admin");
    }

    function isAdmin() {
      return isUserAllowed() && (getUserRole() == "super_admin" || getUserRole() == "admin");
    }

    function getUserPabrikRole() {
      return get(/databases/$(database)/documents/allowed_users/$(request.auth.token.email)).data.pabrikRole;
    }

    function canWritePabrik(pabrikName) {
      return isSuperAdmin()
        || (isAdmin() && (
             getUserPabrikRole() == null
             || getUserPabrikRole() == ""
             || getUserPabrikRole() == "all"
             || (getUserPabrikRole() == "pbr1" && pabrikName.matches(".*PBR 1.*"))
             || (getUserPabrikRole() == "pbr2" && pabrikName.matches(".*PBR 2.*"))
             || (getUserPabrikRole() == "ppg" && pabrikName.matches(".*PPG.*"))
             || (getUserPabrikRole() == "ppj" && pabrikName.matches(".*PPJ.*"))
           ));
    }

    match /allowed_users/{email} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /locked_dates/{date} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /config/{doc} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /vendors/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /jenis_kantong/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /pabrik_list/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /laporan_kantong/{id} {
      allow read: if isAuthenticated();

      allow create: if isAdmin() && canWritePabrik(request.resource.data.pabrik);

      allow update: if isAdmin() && canWritePabrik(request.resource.data.pabrik);

      allow delete: if isAdmin() && canWritePabrik(request.resource.data.pabrik);
    }

    // === Stock Harian Kantong ===
    // Admin & super_admin can write (cascade from laporan_kantong)
    match /stock_harian/{id} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // === Penerimaan Data (from Pelaporan page) ===
    // Only super_admin can create/delete; all authenticated can read
    match /penerimaan_data/{id} {
      allow read: if isAuthenticated();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // === Pengiriman Data (from Pelaporan page) ===
    // Only super_admin can create/delete; all authenticated can read
    match /pengiriman_data/{id} {
      allow read: if isAuthenticated();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // === App Meta (cross-device sync) ===
    match /app_meta/{doc} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
