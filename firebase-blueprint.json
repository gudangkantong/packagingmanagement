{
  "entities": {
    "AllowedUser": {
      "title": "Allowed User",
      "description": "User email address authorized to log in, view real-time data, and edit records.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Email address of the authorized user (lowercase)"
        },
        "allowed": {
          "type": "boolean",
          "description": "Whether this user is allowed to access the application"
        },
        "addedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the user was added"
        }
      },
      "required": ["email", "allowed"]
    },
    "LaporanKantong": {
      "title": "Laporan Kantong",
      "description": "Record representing bag usage report details per shift, pabrik, vendor, and jenis kantong.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the record"
        },
        "vendor": {
          "type": "string",
          "enum": ["GEMAH", "YANA", "HARDO", "IKSG", "KRR", "SAMI", "TRI USAHA"],
          "description": "The name of the vendor"
        },
        "nama": {
          "type": "string",
          "enum": [
            "Semen Baturaja (SMBR)",
            "Semen DYNAMIX (DYX)",
            "Semen MERDEKA (MDK)",
            "Semen PADANG (PDG)",
            "BIGBAG OPC",
            "BIGBAG PCC",
            "MACAN"
          ],
          "description": "Type of the bag (jenis kantong)"
        },
        "pabrik": {
          "type": "string",
          "enum": ["Pabrik Baturaja 1 (PBR 1)", "Pabrik Baturaja 2 (PBR 2)"],
          "description": "The factory location"
        },
        "shift": {
          "type": "integer",
          "enum": [1, 2, 3],
          "description": "The work shift (1, 2, or 3)"
        },
        "tanggal": {
          "type": "string",
          "format": "date",
          "description": "The reporting date (YYYY-MM-DD)"
        },
        "utuh": {
          "type": "integer",
          "description": "Count of intact bags"
        },
        "pecah": {
          "type": "integer",
          "description": "Count of broken bags"
        },
        "sortir": {
          "type": "integer",
          "description": "Count of sorted bags"
        },
        "total": {
          "type": "integer",
          "description": "Sum of utuh + pecah + sortir"
        },
        "createdBy": {
          "type": "string",
          "description": "Email address of the creator"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of the last modification"
        }
      },
      "required": [
        "id",
        "vendor",
        "nama",
        "pabrik",
        "shift",
        "tanggal",
        "utuh",
        "pecah",
        "sortir",
        "total",
        "createdBy",
        "updatedAt"
      ]
    },
    "LockedDate": {
      "title": "Locked Date",
      "description": "Record specifying whether data for a certain date is locked/verified.",
      "type": "object",
      "properties": {
        "locked": {
          "type": "boolean",
          "description": "Whether this date's data is verified and locked"
        },
        "lockedBy": {
          "type": "string",
          "description": "Email address of the admin who locked this date"
        },
        "lockedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when this date was locked"
        }
      },
      "required": ["locked"]
    },
    "PenerimaanData": {
      "title": "Penerimaan Data",
      "description": "Record of incoming goods (penerimaan) input by admin utama from the Pelaporan page.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the record"
        },
        "nama": {
          "type": "string",
          "description": "Type of the bag (jenis kantong)"
        },
        "pabrik": {
          "type": "string",
          "description": "The factory location"
        },
        "tanggal": {
          "type": "string",
          "format": "date",
          "description": "The date (YYYY-MM-DD)"
        },
        "jumlah": {
          "type": "integer",
          "description": "Quantity of incoming goods"
        },
        "keterangan": {
          "type": "string",
          "description": "Optional notes"
        },
        "createdBy": {
          "type": "string",
          "description": "Email address of the creator"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the record was created"
        }
      },
      "required": ["id", "nama", "pabrik", "tanggal", "jumlah"]
    },
    "PengirimanData": {
      "title": "Pengiriman Data",
      "description": "Record of outgoing goods (pengiriman) input by admin utama from the Pelaporan page.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the record"
        },
        "nama": {
          "type": "string",
          "description": "Type of the bag (jenis kantong)"
        },
        "pabrik": {
          "type": "string",
          "description": "The factory location"
        },
        "tanggal": {
          "type": "string",
          "format": "date",
          "description": "The date (YYYY-MM-DD)"
        },
        "jumlah": {
          "type": "integer",
          "description": "Quantity of outgoing goods"
        },
        "keterangan": {
          "type": "string",
          "description": "Optional notes"
        },
        "createdBy": {
          "type": "string",
          "description": "Email address of the creator"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the record was created"
        }
      },
      "required": ["id", "nama", "pabrik", "tanggal", "jumlah"]
    }
  },
  "firestore": {
    "/allowed_users/{email}": {
      "schema": "AllowedUser",
      "description": "Collection of authorized email addresses."
    },
    "/laporan_kantong/{id}": {
      "schema": "LaporanKantong",
      "description": "Collection of real-time bag usage reports."
    },
    "/locked_dates/{date}": {
      "schema": "LockedDate",
      "description": "Collection of dates that have been locked/verified by the main admin."
    },
    "/penerimaan_data/{id}": {
      "schema": "PenerimaanData",
      "description": "Collection of incoming goods data input by admin utama."
    },
    "/pengiriman_data/{id}": {
      "schema": "PengirimanData",
      "description": "Collection of outgoing goods data input by admin utama."
    }
  }
}
